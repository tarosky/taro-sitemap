msgid "No Indexable Taxonomies"
msgstr "noindexにするタクソノミー"

#: src/Tarosky/Sitemap/Setting.php:274
msgid "Each term in checked taxonomies will have noindex setting field."
msgstr ""
"チェックされたタクソノミーのそれぞれのタームがnoindexの設定項目を持つようにな"
"ります。"

#: src/Tarosky/Sitemap/Setting.php:280
msgid "Noindex Archive"
msgstr "noindexにするアーカイブ"

#: src/Tarosky/Sitemap/Setting.php:282
msgid "Archive page greater than this number will be noindex."
msgstr "この数値より大きいアーカイブページはnoindexになります。"

#: src/Tarosky/Sitemap/Setting.php:283
msgid "e.g. 6"
msgstr "例・6"

#: src/Tarosky/Sitemap/Setting.php:288
msgid "Other Page"
msgstr "その他のページ"

#: src/Tarosky/Sitemap/Setting.php:290
msgid "Miscellaneous pages to be no-indexed."
msgstr "noindexにしたいその他のページです。"

#: src/Tarosky/Sitemap/Setting.php:294
msgid "Search Results"
msgstr "検索結果"

